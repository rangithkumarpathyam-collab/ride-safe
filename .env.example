# ==============================================================================
# SafeRide AI - Environment Variables & API Configuration Template
# Copy this file to .env and replace placeholder values with your actual keys.
# ==============================================================================

# --- System & Application Settings ---
APP_ENV=development
APP_PORT=8502
SQLITE_DB_PATH=saferide.db

# --- Module 3: GIS Mapping & Geocoding ---
# Geoapify Geocoding API Key (or Google Maps Geocoding API Key)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# OpenStreetMap + Leaflet is used for mapping (100% Free & Open Source - No Mapbox token or billing required!)

# --- Module 4: Multilingual Translation Services (Telugu <-> English) ---
OPENAI_API_KEY=your_openai_api_key_here
BHASHINI_API_KEY=your_bhashini_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Module 6: Emergency Alerts & Automated Notifications ---
# Twilio Automated Voice Calling & SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
EMERGENCY_DISPATCH_PHONE=+91XXXXXXXXXX

# Telegram Emergency Bot (Optional)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-100XXXXXXXXXX

# SMTP Email Alert Service (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
EMERGENCY_ALERT_RECIPIENT=emergency_team@hospital.org
